@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation /* conector que establece navegacion programatica para hacer el enrrutamiento y la llamada     */
@using MovieZone.Components.Pages

<div style="display: flex; flex-direction: column; width: 100%; padding: 20px; box-sizing: border-box;">

    <!-- ENCABEZADO CON BARRA DE BÚSQUEDA Y BOTÓN PARA RESTABLECER -->
    <header style="display: flex; align-items: center; gap: 10px; margin-bottom: 30px; width: 100%;">
        <input type="text" 
               placeholder="Buscar película y presionar Enter..." 
               maxlength="30"
               @bind-value="textoBusqueda" 
               @bind-value:event="oninput" 
               @onkeydown="ManejarKeyDown"
               style="width: 320px; padding: 10px 15px; border-radius: 6px; border: 1px solid #333; font-size: 0.95rem; background-color: #ffffff; color: #000000;" />

        <!-- BOTÓN PARA LIMPIAR Y MOSTRAR TODAS LAS PELÍCULAS DE NUEVO -->
        <button @onclick="LimpiarBusqueda" 
                style="background-color: #e5a93b; color: #121212; border: none; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.9rem; display: flex; align-items: center; gap: 5px;">
            <i class="bi bi-arrow-counterclockwise"></i> Borrar

        </button>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main>
       
        <h2 style="color: #ffffff; font-size: 2rem; margin-bottom: 25px; font-weight: 600; font-family: system-ui, sans-serif;">Peliculas disponibles</h2>

        <!-- GRILLA DE PELÍCULAS -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; width: 100%;">

            @foreach (var peli in PeliculasFiltradas) 
            {
                <NavLink href="@peli.Url" style="text-decoration: none; cursor: pointer;">
                    <TarjetaPelicula Titulo="@peli.Titulo" 
                                     Imagen="@peli.Imagen" 
                                     AlturaImagen="260px" />
                </NavLink>
            }

        </div>
    </main>

</div>

<!-- C# (LÓGICA DE LA PÁGINA) -->
@code {
  
    private string textoBusqueda = "";
    private string busquedaAplicada = "";

    
    public class Pelicula
    {
        public string Titulo { get; set; } = "";
        public string Imagen { get; set; } = "";
        public string Url { get; set; } = "";
    }

    // Lista con las 16 películas actuales
    private List<Pelicula> MisPeliculas = new List<Pelicula>
    {
        new Pelicula { Titulo = "Batman", Imagen = "imagenes/batman.jpg", Url = "ver/batman" },
        new Pelicula { Titulo = "Dune", Imagen = "imagenes/duna.jpg", Url = "ver/dune" },
        new Pelicula { Titulo = "Avatar", Imagen = "imagenes/avatar.jpg", Url = "ver/avatar" },
        new Pelicula { Titulo = "John Wick", Imagen = "imagenes/johnwick.jpg", Url = "ver/john-wick" },
        new Pelicula { Titulo = "Kraven", Imagen = "imagenes/kraven.jpg", Url = "ver/kraven" },
        new Pelicula { Titulo = "Aladdín", Imagen = "imagenes/aladin.jpg", Url = "ver/aladdin" },
        new Pelicula { Titulo = "La leyenda de Aang", Imagen = "imagenes/aang.jpg", Url = "ver/la-leyenda-de-aang" },
        new Pelicula { Titulo = "Avengers: Endgame", Imagen = "imagenes/avengers.jpg", Url = "ver/avengers" },
        new Pelicula { Titulo = "Wonka", Imagen = "imagenes/Wonka.jpg", Url = "ver/wonka" },
        new Pelicula { Titulo = "Crepúsculo: Amanecer", Imagen = "imagenes/amanecer.jpg", Url = "ver/crepusculo" },
        new Pelicula { Titulo = "Cómo entrenar a tu dragón", Imagen = "imagenes/dragón.jpg", Url = "ver/como-entrenar-a-tu-dragon" },
        new Pelicula { Titulo = "El Conjuro", Imagen = "imagenes/conjuro.jpg", Url = "ver/el-conjuro" },
        new Pelicula { Titulo = "Mario Bros", Imagen = "imagenes/mario.jpg", Url = "ver/mario-bros" },
        new Pelicula { Titulo = "Madagascar 3", Imagen = "imagenes/madagascar.jpg", Url = "ver/madagascar" },
        new Pelicula { Titulo = "Maléfica", Imagen = "imagenes/malefica.jpg", Url = "ver/malefica" },
        new Pelicula { Titulo = "Demon Slayer", Imagen = "imagenes/demosslayer.jpg", Url = "ver/demon-slayer" }
    };

    // Colección filtrada basada únicamente en la búsqueda confirmada
    private IEnumerable<Pelicula> PeliculasFiltradas =>
        string.IsNullOrWhiteSpace(busquedaAplicada)
            ? MisPeliculas
            : MisPeliculas.Where(p => p.Titulo.Contains(busquedaAplicada, StringComparison.OrdinalIgnoreCase));

    // Captura la tecla presionada
    private void ManejarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            EjecutarBusqueda();
        }
    }

    private void EjecutarBusqueda()
    {
        string consulta = textoBusqueda.Trim();

        // Si se presiona Enter con el buscador vacío, restaura todas las películas
        if (string.IsNullOrWhiteSpace(consulta))
        {
            busquedaAplicada = "";
            return;
        }

        // Verifica si existe al menos una coincidencia
        bool existeCoincidencia = MisPeliculas.Any(p => p.Titulo.Contains(consulta, StringComparison.OrdinalIgnoreCase));

        if (!existeCoincidencia) // filtra y redirige al cartel de error con mensaje personalizados si no hay coincidencias
        {
            string mensaje = $"No se encontraron películas que coincidan con '{consulta}'.";
            Navigation.NavigateTo($"/cartel-error/{Uri.EscapeDataString(mensaje)}");
            // Enrrutamiento con el cartel de error y mensaje dinamico.
        }
        else
        {
            busquedaAplicada = consulta;
        }
    }

    // Restablece el buscador y vuelve a cargar las 16 películas
    private void LimpiarBusqueda()
    {
        textoBusqueda = "";
        busquedaAplicada = "";
    }
}