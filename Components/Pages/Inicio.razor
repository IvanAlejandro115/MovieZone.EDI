@page "/inicio"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject MovieZone.AppDbContext DbContext /* conecta la pag con micoleccion por medio de la base de datos SQLite */ 



<div style="display: flex; flex-direction: column; width: 100%; padding: 20px; box-sizing: border-box; font-family: system-ui, sans-serif;">

    <!-- BANNER DESTACADO GIGANTE (HERO SELECTION) -->
    <div style="width: 100%; height: 350px; border-radius: 16px; overflow: hidden; position: relative; margin-bottom: 40px; box-shadow: 0 8px 20px rgba(0,0,0,0.5); border: 1px solid #333;">
        
        <!-- IMAGEN DE FONDO OSCURECIDA CON FILTRO CSS -->
        <img src="imagenes/batman.jpg" alt="Destacado" style="width: 100%; height: 100%; object-fit: cover; filter: brightness(35%) blur(0.5px);" />
        
        <!-- Contenedor del texto sobre el cartel -->
        <div style="position: absolute; bottom: 40px; left: 40px; max-width: 550px; z-index: 2;">
            <span style="background-color: #e50914; color: #ffffff; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; letter-spacing: 1px; font-family: system-ui, sans-serif;">EL ESTRENO DEL MES</span>
            <h1 style="color: #ffffff; font-size: 3rem; margin: 10px 0 5px 0; font-weight: 700;">The Batman</h1>
            <p style="color: #b3b3b3; font-size: 1rem; margin-bottom: 0; line-height: 1.4;">En su segundo año luchando contra el crimen, Batman explora la corrupción en Gotham City y se enfrenta al asesino Enigma.</p>
        </div>
    </div>

    <!-- SECCIÓN SECUNDARIA: MI COLECCIÓN / CONTINUAR VIENDO (DINÁMICA DESDE SQLITE) -->
    <main>
        <h2 style="color: #ffffff; font-size: 1.5rem; margin-bottom: 20px; font-weight: 600;">Continuar viendo</h2>
        
        @if (peliculasGuardadas == null)
        {
            <div style="color: #b3b3b3;">Cargando películas de tu colección...</div>
        }
        else if (!peliculasGuardadas.Any())
        {
            <div style="color: #b3b3b3; background-color: #1a1c20; padding: 20px; border-radius: 12px; border: 1px solid #333;">
                Aún no tienes películas en tu colección. Ve a <a href="/mi-coleccion" style="color: #e5a93b; font-weight: bold;">Mi Colección</a> para agregar alguna.
            </div>
        }
        else
        {
            // GRILLA DE 4 COLUMNAS CON LAS PELÍCULAS DE TU BASE DE DATOS -->
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; width: 100%;">
                @foreach (var peli in peliculasGuardadas)
                {
                    <NavLink href="/mi-coleccion" style="text-decoration: none; background-color: #1a1c20; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid #333; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                        <div style="position: relative; height: 160px; width: 100%;">
                            <img src="@peli.Imagen" alt="@peli.Titulo" style="width: 100%; height: 100%; object-fit: cover;" />
                                                     
                            <div style="position: absolute; bottom: 0; left: 0; height: 4px; width: 75%; background-color: #e50914;"></div>
                        </div>
                        <div style="padding: 12px;">
                            <h3 style="color: #ffffff; font-size: 1rem; margin: 0 0 5px 0; font-weight: 500;">@peli.Titulo</h3>
                            <span style="color: #e5a93b; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">@peli.Etiqueta</span>
                        </div>
                    </NavLink>
                }
            </div>
        }
    </main>

</div>


@code {
    private List<MovieZone.PeliculaColeccion>? peliculasGuardadas;

    protected override async Task OnInitializedAsync()
    {
        // Consulta todas las películas guardadas en SQLite, mostrando primero las últimas agregadas
        peliculasGuardadas = await DbContext.PeliculasColeccion
            .OrderByDescending(p => p.Id)
            .ToListAsync();
    }
}