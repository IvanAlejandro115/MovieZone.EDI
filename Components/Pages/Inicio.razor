@page "/inicio"
@rendermode InteractiveServer


<!-- HTML (ESTRUCTURA VISUAL DE LA PÁGINA INICIO) -->

<div style="display: flex; flex-direction: column; width: 100%; padding: 20px; box-sizing: border-box; font-family: system-ui, sans-serif;">

    
    <!-- BANNER DESTACADO GIGANTE (HERO SELECTION)            -->
   
 <!-- AQUÍ SE USA CSS (POSICIÓN RELATIVA Y SOMBRA DE FONDO) -->
<div style="width: 100%; height: 350px; border-radius: 16px; overflow: hidden; position: relative; margin-bottom: 40px; box-shadow: 0 8px 20px rgba(0,0,0,0.5); border: 1px solid #333;">
    
    <!-- AQUÍ SE USA HTML (IMAGEN DE FONDO OSCURECIDA CON FILTRO CSS) -->
    <img src="imagenes/batman.jpg" alt="Destacado" style="width: 100%; height: 100%; object-fit: cover; filter: brightness(35%) blur(0.5px);" />
    
    <!-- Contenedor del texto sobre el cartel (Sin el botón de reproducción) -->
    <div style="position: absolute; bottom: 40px; left: 40px; max-width: 550px; z-index: 2;">
        <span style="background-color: #e50914; color: #ffffff; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; letter-spacing: 1px; font-family: system-ui, sans-serif;">EL ESTRENO DEL MES</span>
        <h1 style="color: #ffffff; font-size: 3rem; margin: 10px 0 5px 0; font-weight: 700;">The Batman</h1>
        <p style="color: #b3b3b3; font-size: 1rem; margin-bottom: 0; line-height: 1.4;">En su segundo año luchando contra el crime, Batman explora la corrupción en Gotham City y se enfrenta al asesino Enigma.</p>
    </div>
</div>



    <!-- SECCIÓN SEGUNDARIA: CONTINUAR VIENDO       -->          
    <main>
        <h2 style="color: #ffffff; font-size: 1.5rem; margin-bottom: 20px; font-weight: 600;">Continuar viendo</h2>
        
        <!-- AQUÍ SE USA: CSS (GRILLA MATE DE HORIZONTAL DE 4 COLUMNAS) -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; width: 100%;">

            <!-- Tarjeta 1 (Avatar) -->
            <NavLink href="ver/avatar" style="text-decoration: none; background-color: #1a1c20; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid #333; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                <div style="position: relative; height: 160px; width: 100%;">
                    <img src="imagenes/avatar.jpg" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                    <!-- BARRA DE PROGRESO ROJA EN CSS (70% Completado) -->
                    <div style="position: absolute; bottom: 0; left: 0; height: 4px; width: 70%; background-color: #e50914;"></div>
                </div>
                <h3 style="color: #ffffff; font-size: 1rem; margin: 12px; font-weight: 500;">Avatar</h3>
            </NavLink>

            <!-- Tarjeta 2 (Dune) -->
            <NavLink href="ver/dune" style="text-decoration: none; background-color: #1a1c20; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid #333; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                <div style="position: relative; height: 160px; width: 100%;">
                    <img src="imagenes/duna.jpg" alt="Dune" style="width: 100%; height: 100%; object-fit: cover;" />
                    <!-- BARRA DE PROGRESO ROJA EN CSS (35% Completado) -->
                    <div style="position: absolute; bottom: 0; left: 0; height: 4px; width: 35%; background-color: #e50914;"></div>
                </div>
                <h3 style="color: #ffffff; font-size: 1rem; margin: 12px; font-weight: 500;">Dune</h3>
            </NavLink>

            <!-- Tarjeta 3 (John Wick) -->
            <NavLink href="ver/john-wick" style="text-decoration: none; background-color: #1a1c20; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid #333; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                <div style="position: relative; height: 160px; width: 100%;">
                    <img src="imagenes/johnwick.jpg" alt="John Wick" style="width: 100%; height: 100%; object-fit: cover;" />
                    <!--  BARRA DE PROGRESO ROJA EN CSS (90% Completado) -->
                    <div style="position: absolute; bottom: 0; left: 0; height: 4px; width: 90%; background-color: #e50914;"></div>
                </div>
                <h3 style="color: #ffffff; font-size: 1rem; margin: 12px; font-weight: 500;">John Wick</h3>
            </NavLink>

            <!-- Tarjeta 4 (Wonka) -->
            <NavLink href="ver/wonka" style="text-decoration: none; background-color: #1a1c20; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid #333; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                <div style="position: relative; height: 160px; width: 100%;">
                    <img src="imagenes/Wonka.jpg" alt="Wonka" style="width: 100%; height: 100%; object-fit: cover;" />
                    <!-- BARRA DE PROGRESO ROJA EN CSS (15% Completado) -->
                    <div style="position: absolute; bottom: 0; left: 0; height: 4px; width: 15%; background-color: #e50914;"></div>
                </div>
                <h3 style="color: #ffffff; font-size: 1rem; margin: 12px; font-weight: 500;">Wonka</h3>
            </NavLink>

        </div>
    </main>

</div>

<!-- AQUÍ TERMINA: HTML Y CSS DE LA PÁGINA INICIO            -->