@page "/cartel-error" 
@page "/cartel-error/{MensajeError}" // routing: que permite pasar un mensaje de error personalizado a la página de error al llamarla desde otra página. El parámetro MensajeError se utiliza para mostrar un mensaje específico en el cartel de error.
@rendermode InteractiveServer
@inject IJSRuntime JS // inyección de IJSRuntime para ejecutar comandos de JavaScript e interactuar con el navegador web //

<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh; width: 100%; padding: 20px; box-sizing: border-box; font-family: system-ui, sans-serif;">
    
    <!-- TARJETA / CARTEL DE ERROR -->
    <div style="background-color: #1a1c20; border: 2px solid #dc3545; border-radius: 16px; padding: 35px 30px; width: 100%; max-width: 450px; text-align: center; box-shadow: 0 8px 24px rgba(220, 53, 69, 0.25); color: #ffffff;">
        
        <!-- Ícono de Advertencia -->
        <div style="font-size: 3.5rem; margin-bottom: 15px; line-height: 1;">
            ⚠️
        </div>

        <h2 style="color: #dc3545; font-size: 1.8rem; font-weight: 700; margin: 0 0 15px 0;">
            ¡Error de Validación!
        </h2>
        
        <p style="color: #cfd2d6; font-size: 1.05rem; line-height: 1.5; margin-bottom: 25px;">
            @(string.IsNullOrWhiteSpace(MensajeError) // 
                ? "El título ingresado no coincide con ninguna película registrada en el sistema." 
                : MensajeError)
        </p>

        <!-- Botón Aceptar para regresar a la página previa -->
        <button @onclick="VolverPaginaAnterior" style="background-color: #dc3545; color: #ffffff; border: none; padding: 12px 35px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 1rem; transition: background-color 0.2s;">
            Aceptar
        </button>

    </div>

</div>


@code { 
    [Parameter]
    public string? MensajeError { get; set; }

    private async Task VolverPaginaAnterior()
    {
        // Ejecuta el comando de JavaScript para ir a la página anterior en el historial del navegador
        await JS.InvokeVoidAsync("history.back");
    }
}